{
  "manifest_version": 3,
  "name": "SentryAI Agent (MVP)",
  "version": "0.3.0",
  "description": "Scans prompts and files on supported AI web apps and asks permission before sensitive content is sent.",

  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://*.perplexity.ai/*",
    "https://grok.com/*",
    "https://*.grammarly.com/*",
    "https://*.quillbot.com/*",
    "http://127.0.0.1:3000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://*.perplexity.ai/*",
        "https://grok.com/*",
        "https://*.grammarly.com/*",
        "https://*.quillbot.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "SentryAI Agent"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
